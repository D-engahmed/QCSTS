DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CELERY_BEAT_TIMEZONE=Africa/Cairo

POSTGRES_USER=qcsts
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=qcsts
DATABASE_URL=postgres://qcsts:replace-with-a-long-random-password@db:5432/qcsts

REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_URL=redis://:replace-with-a-long-random-password@redis:6379/0

THROTTLE_LOGIN=10/min
THROTTLE_SIGNATURE=20/min
THROTTLE_ANON=60/min
