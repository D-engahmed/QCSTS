DJANGO_SECRET_KEY=django-insecure-cqsts-dev-key-change-this-in-production-123456789
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database / infrastructure
# DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=postgres://postgres:postgres@db:5432/cqsts_db
REDIS_URL=redis://redis:6379/0
CELERY_BEAT_TIMEZONE=Africa/Cairo

# Paymob — set only in real environments. Never commit the secret.
PAYMOB_HMAC_SECRET=

# Next.js local development runs on port 3000
# Keep production/staging origins explicit and environment-specific.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
